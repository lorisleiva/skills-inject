{
  "name": "skills-inject",
  "version": "0.1.3",
  "description": "Inject skill summaries into your agent instruction files (CLAUDE.md, AGENTS.md)",
  "type": "module",
  "bin": {
    "skills-inject": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && pnpm changeset publish"
  },
  "keywords": [
    "skills",
    "agent-skills",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "inject",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lorisleiva/skills-inject.git"
  },
  "author": "Loris Leiva",
  "license": "MIT",
  "packageManager": "pnpm@10.6.4",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@clack/prompts": "^1.0.1",
    "@types/node": "^25.3.2",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
